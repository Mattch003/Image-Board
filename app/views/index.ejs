<%# Home feed — hero (logged-out only), recent posts, sidebar with stats and top contributors. %>
<%- include('partials/header', { wide: true }) %>

<% if (!currentUser) { %>
  <section class="hero">
    <h1 class="hero-title">Share what you see.</h1>
    <p class="hero-subtitle">Discover what others love. Post photos, drop a like, leave a comment.</p>
    <div class="hero-actions">
      <a href="/register" class="btn btn-primary">Get Started</a>
      <a href="/login" class="btn btn-ghost">Log In</a>
    </div>
  </section>
<% } %>

<div class="home-grid">
  <div class="home-main">
    <h2 class="section-title">Recent Posts</h2>

    <% if (!posts.length) { %>
      <div class="empty-state">
        <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <polyline points="21 15 16 10 5 21"/>
        </svg>
        <p>No posts yet.</p>
        <% if (currentUser) { %>
          <a href="/upload" class="btn btn-primary">Upload the First Image</a>
        <% } %>
      </div>
    <% } %>

    <div class="feed">
      <% posts.forEach(function(p){ %>
        <article class="post">
          <a href="/posts/<%= p.id %>">
            <img src="<%= p.image_path %>" alt="" />
          </a>
          <div class="post-body">
            <div class="post-meta">
              <%- include('partials/avatar', { username: p.username, size: 36 }) %>
              <div class="post-meta-text">
                <strong>@<%= p.username %></strong>
                <span class="muted"><%= new Date(p.created_at).toLocaleString() %></span>
              </div>
            </div>
            <% if (p.caption) { %><p class="post-caption"><%= p.caption %></p><% } %>
            <div class="post-actions">
              <% if (currentUser) { %>
                <form action="/posts/<%= p.id %>/<%= p.liked_by_me ? 'unlike' : 'like' %>" method="post" class="inline">
                  <button type="submit" class="like-btn <%= p.liked_by_me ? 'liked' : '' %>">
                    <%= p.liked_by_me ? '♥' : '♡' %> <%= p.like_count %>
                  </button>
                </form>
              <% } else { %>
                <span class="like-btn">♡ <%= p.like_count %></span>
              <% } %>
              <a href="/posts/<%= p.id %>" class="comment-link">💬 <%= p.comment_count %></a>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  </div>

  <aside class="sidebar">
    <h2 class="section-title">At a Glance</h2>

    <% if (currentUser && myStats) { %>
      <div class="sidebar-card">
        <h3 class="sidebar-title">Your Activity</h3>
        <ul class="my-stats">
          <li><span class="my-stat-label">Your posts</span><span class="my-stat-num"><%= myStats.my_posts %></span></li>
          <li><span class="my-stat-label">Likes received</span><span class="my-stat-num"><%= myStats.likes_received %></span></li>
          <li><span class="my-stat-label">Comments received</span><span class="my-stat-num"><%= myStats.comments_received %></span></li>
        </ul>
      </div>
    <% } else { %>
      <div class="sidebar-card">
        <h3 class="sidebar-title">How It Works</h3>
        <ol class="how-it-works">
          <li><span class="step-num">1</span><span>Browse the feed of recent photos.</span></li>
          <li><span class="step-num">2</span><span>Create an account to post your own.</span></li>
          <li><span class="step-num">3</span><span>Like and comment to join the conversation.</span></li>
        </ol>
      </div>
    <% } %>

    <div class="sidebar-card">
      <h3 class="sidebar-title">By the Numbers</h3>
      <ul class="stats-list">
        <li><span class="stat-num"><%= stats.total_posts %></span><span class="stat-label">Posts</span></li>
        <li><span class="stat-num"><%= stats.total_users %></span><span class="stat-label">Users</span></li>
        <li><span class="stat-num"><%= stats.total_likes %></span><span class="stat-label">Likes</span></li>
      </ul>
    </div>

    <% if (topUsers.length) { %>
      <div class="sidebar-card">
        <h3 class="sidebar-title">Top Contributors</h3>
        <ul class="user-list">
          <% topUsers.forEach(function(u){ %>
            <li>
              <%- include('partials/avatar', { username: u.username, size: 32 }) %>
              <div class="user-list-text">
                <strong>@<%= u.username %></strong>
                <span class="muted"><%= u.post_count %> post<%= u.post_count == 1 ? '' : 's' %></span>
              </div>
            </li>
          <% }) %>
        </ul>
      </div>
    <% } %>

  </aside>
</div>

<%- include('partials/footer') %>
